# URL de l'API telle que vue PAR LE NAVIGATEUR
# En local (API sur le host) :
VITE_API_BASE_URL=http://localhost:8000

# Si tu utilises le proxy nginx (/api → service api) :
# VITE_API_BASE_URL=/api

# Production (domaine public de l'API) :
# VITE_API_BASE_URL=https://api.senterangasafe.example.com
