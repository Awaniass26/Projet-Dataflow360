q"""
streaming/producer.py

Simule le flux de transactions arrivant en temps réel sur la plateforme.
Contrairement au générateur historique (Sprint 1), ce script :
  - génère des transactions datées de MAINTENANT, en continu
  - ne contient JAMAIS de label `fraude` — personne ne le sait à cet instant
  - calcule les features du modèle fraude (depuis PostgreSQL)
  - publie chaque transaction sur Kafka, topic "transactions.raw"

Usage : python producer.py [--intervalle-sec 1] [--n-max 0]
    --n-max 0 = tourne indéfiniment (Ctrl+C pour arrêter)
"""

import argparse
import json
import os
import random
import time
from datetime import datetime

import numpy as np
import pandas as pd
from kafka import KafkaProducer
from sqlalchemy import create_engine, text

try:
    from dotenv import load_dotenv
    load_dotenv(os.path.join(os.path.dirname(__file__), "..", ".env"))
except ImportError:
    pass

PG_USER = os.getenv("POSTGRES_USER", "terangasafe")
PG_PASSWORD = os.getenv("POSTGRES_PASSWORD", "terangasafe_pwd")
PG_DB = os.getenv("POSTGRES_DB", "terangasafe")
PG_HOST = os.getenv("POSTGRES_HOST", "localhost")
PG_PORT = os.getenv("POSTGRES_PORT", "5433")

KAFKA_HOST = os.getenv("KAFKA_HOST", "localhost")
KAFKA_PORT = os.getenv("KAFKA_PORT", "9092")
TOPIC = "transactions.raw"

TYPES = ["transfert", "paiement", "retrait", "dépôt"]
POIDS_TYPES = [0.50, 0.30, 0.15, 0.05]
CANAUX = ["app", "USSD", "agent"]
POIDS_CANAUX = [0.55, 0.30, 0.15]


def _get_engine():
    """Crée le moteur SQLAlchemy (psycopg v3)."""
    url = f"postgresql+psycopg://{PG_USER}:{PG_PASSWORD}@{PG_HOST}:{PG_PORT}/{PG_DB}"
    return create_engine(url)


def charger_comptes_et_appareils(engine):
    """Récupère les clients depuis la table api_clients de l'API."""
    comptes = pd.read_sql_table("api_clients", engine)
    comptes = comptes.rename(columns={
        "client_id": "id_compte",
        "region": "zone_habituelle",
    })
    if "statut_compte" not in comptes.columns:
        comptes["statut_compte"] = "actif"

    # Un appareil fictif par client (on n'a pas l'info appareil)
    appareils_par_compte = {
        cid: [f"dev_{cid}"]
        for cid in comptes["id_compte"].unique()
    }

    return comptes, appareils_par_compte


def compute_features_from_history(client_id: str, montant: float, engine) -> dict:
    """Calcule les features du modèle fraude depuis l'historique PostgreSQL.

    Remplace le profil Redis (vide) par un calcul direct :
    - montant_moyen sur 90 jours
    - ecart_montant_moyen
    - nouvel_appareil (5% aléatoire)
    - nouveau_destinataire (10% aléatoire)
    """
    with engine.begin() as conn:
        result = conn.execute(text("""
            SELECT AVG(amount) AS montant_moyen
            FROM api_transactions
            WHERE client_id = :cid
              AND occurred_at >= NOW() - INTERVAL '90 days'
        """), {"cid": client_id}).fetchone()

        montant_moyen = float(result.montant_moyen) if result.montant_moyen else montant

    # Écart au montant moyen (borné pour éviter les extrêmes)
    ecart_montant_moyen = montant / montant_moyen if montant_moyen > 0 else 1.0
    ecart_montant_moyen = max(0.1, min(ecart_montant_moyen, 20.0))

    # Heure actuelle
    hour = datetime.now().hour

    # Nouvel appareil / nouveau destinataire : aléatoire réaliste
    nouvel_appareil = random.random() < 0.05
    nouveau_destinataire = random.random() < 0.10

    return {
        "hour": hour,
        "ecart_montant_moyen": round(ecart_montant_moyen, 2),
        "ecart_heure_habituelle": 0.0,
        "nouvel_appareil": nouvel_appareil,
        "nouveau_destinataire": nouveau_destinataire,
    }


def generer_une_transaction(rng, comptes_df, appareils_par_compte, id_transaction, engine):
    ligne = comptes_df.sample(1, random_state=None).iloc[0]
    id_compte_emetteur = ligne["id_compte"]
    zone = ligne["zone_habituelle"]

    # Montants alignés sur la distribution de la note EDA
    # (médiane ~440k, moyenne ~740k)
    montant = float(np.clip(
        rng.lognormal(mean=10.0, sigma=0.8),
        100,
        300_000,
    ))
    type_ = str(rng.choice(TYPES, p=POIDS_TYPES))
    canal = str(rng.choice(CANAUX, p=POIDS_CANAUX))

    # Destinataire aléatoire (pour transfert/paiement), différent de l'émetteur
    destinataire = ""
    if type_ in ["transfert", "paiement"]:
        autres_comptes = comptes_df[comptes_df["id_compte"] != id_compte_emetteur]
        if len(autres_comptes) > 0:
            destinataire = str(autres_comptes.sample(1).iloc[0]["id_compte"])

    # Appareil : habituel 95%, nouveau 5%
    devs_connus = appareils_par_compte.get(id_compte_emetteur, [])
    if devs_connus and rng.random() < 0.95:
        id_appareil = rng.choice(devs_connus)
    else:
        id_appareil = f"dev_new_{rng.integers(100000, 999999)}"

    # --- Calcul des features du modèle fraude ---
    features = compute_features_from_history(id_compte_emetteur, montant, engine)

    return {
        "id_transaction": f"txn_live_{id_transaction:010d}",
        "id_compte_emetteur": str(id_compte_emetteur),
        "id_compte_destinataire": str(destinataire),
        "montant": round(montant, 2),
        "horodatage": datetime.now().strftime("%Y-%m-%dT%H:%M:%S"),
        "type": type_,
        "canal": canal,
        "zone_geo": zone,
        "id_appareil": str(id_appareil),
        # Features du modèle fraude
        **features,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--intervalle-sec", type=float, default=1.0,
                        help="Délai entre deux transactions simulées")
    parser.add_argument("--n-max", type=int, default=0,
                        help="Nombre de transactions à envoyer (0 = illimité)")
    args = parser.parse_args()

    # Connexion PostgreSQL
    engine = _get_engine()

    print("Chargement des clients depuis PostgreSQL...")
    comptes_df, appareils_par_compte = charger_comptes_et_appareils(engine)
    print(f"{len(comptes_df)} clients actifs chargés.")

    print(f"Connexion à Kafka ({KAFKA_HOST}:{KAFKA_PORT})...")
    producer = KafkaProducer(
        bootstrap_servers=f"{KAFKA_HOST}:{KAFKA_PORT}",
        value_serializer=lambda v: json.dumps(v).encode("utf-8"),
    )

    rng = np.random.default_rng()
    compteur = 0
    print(f"Démarrage de la simulation (topic '{TOPIC}'). Ctrl+C pour arrêter.")

    try:
        while args.n_max == 0 or compteur < args.n_max:
            tx = generer_une_transaction(
                rng, comptes_df, appareils_par_compte, compteur, engine,
            )
            producer.send(TOPIC, value=tx)
            print(
                f"  -> envoyé {tx['id_transaction']} | "
                f"{tx['montant']:.0f} FCFA | {tx['type']} | "
                f"ecart={tx['ecart_montant_moyen']}"
            )
            compteur += 1
            time.sleep(args.intervalle_sec)
    except KeyboardInterrupt:
        print("\nArrêt demandé.")
    finally:
        producer.flush()
        producer.close()
        engine.dispose()
        print(f"Total envoyé : {compteur} transactions.")


if __name__ == "__main__":
    main()
