# # Copier ce fichier en `.env` à la racine du projet, puis renseigner les
# # valeurs réelles. NE JAMAIS committer de vrai mot de passe ou secret.

# # --- Application ---
# APP_NAME="DataFlow360 API"
# APP_VERSION="0.1.0"
# ENVIRONMENT=development

# # CORS : URL(s) du dashboard Dash autorisée(s), séparées par des virgules.
# # Port 8050 = port par défaut de Dash ; à confirmer avec le membre Frontend.
# CORS_ALLOWED_ORIGINS=http://localhost:8050,http://127.0.0.1:8050

# # Active des réponses de simulation quand un modèle ML n'est pas encore
# # configuré. À mettre à "false" avant toute démonstration avec un vrai
# # modèle, et interdit en production (l'application refuse de démarrer sinon).
# SIMULATION_ENABLED=true

# # --- PostgreSQL ---
# # Port hôte publié par Docker (le port interne reste 5432).
# POSTGRES_PORT=5433
# # Laisser vide tant que la base n'est pas prête : l'API démarre quand même,
# # seules les routes qui en dépendent renverront une erreur 503 explicite.
# # Format : postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE
# DATABASE_URL=postgresql+psycopg://terangasafe:terangasafe_pwd@postgres:5432/terangasafe

# # --- Modèle de détection de fraude (à renseigner par/avec le membre ML) ---
# FRAUD_MODEL_PATH=/home/hawa-niass/Projet-Dataflow360/models/fraude/modele_fraude_final.pkl
# FRAUD_MODEL_VERSION=
# FRAUD_DECISION_THRESHOLD=0.5

# # --- Modèle de scoring de crédit (à renseigner par/avec le membre ML) ---
# CREDIT_MODEL_PATH=
# CREDIT_MODEL_VERSION=

# Copier en .env pour personnaliser (facultatif : les valeurs par défaut suffisent).
# Ne JAMAIS committer .env.

# --- Application ---
ENVIRONMENT=development          # development | test | production
SIMULATION_ENABLED=true          # interdit si ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_USER=terangasafe
POSTGRES_PASSWORD=terangasafe_pwd
POSTGRES_DB=terangasafe
POSTGRES_PORT=5433               # port exposé sur l'hôte

# --- MongoDB ---
MONGO_USER=terangasafe
MONGO_PASSWORD=terangasafe_pwd
MONGO_DB=terangasafe
MONGO_PORT=27018                 # port exposé sur l'hôte

# --- Redis ---
REDIS_PORT=6379

# --- Ports exposés ---
API_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000

# --- Frontend (variable de BUILD : relancer avec --build si modifiée) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Modèle de fraude ---
FRAUD_MODEL_VERSION=local
FRAUD_DECISION_THRESHOLD=0.5

# --- Authentification JWT ---
JWT_SECRET=change-me-in-production-please-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440